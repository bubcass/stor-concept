                    "marks": [
                      {
                        "type": "link",
                        "attrs": {
                          "href": "https://www.ifa.ie/farm-sectors/forest-owners-reminded-to-be-vigilant-about-fire-danger/",
                          "target": "_blank",
                          "rel": "noopener noreferrer nofollow",
                          "class": null,
